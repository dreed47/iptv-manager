# Copy this file to .env and edit as needed

# Port mapping for the host (left side of ports: mapping)
# Set a unique APP_PORT per folder if you want to run multiple instances
APP_PORT=5005

# Advertised host that Plex will use to reach the app
# If Plex is on the SAME Mac, set to 127.0.0.1 (recommended)
# If Plex is on ANOTHER machine, set to this Mac's LAN IP (e.g., 192.168.1.50)
# Note: host.docker.internal only resolves INSIDE containers; Plex (on host) won't resolve it.
HDHR_ADVERTISE_HOST=127.0.0.1
HDHR_SCHEME=http

# Model number shown in Plex (default: "HDHR3-US")
# Common HDHomeRun models: HDHR3-US, HDHR4-2US, HDHR5-4US, HDTC-2US
HDHR_MODEL=HDHR3-US

# Friendly name shown in Plex for this HDHomeRun device (default: "IPTV HDHomeRun")
# Useful for distinguishing multiple instances (e.g., "IPTV Sports", "IPTV News")
HDHR_FRIENDLY_NAME=IPTV HDHomeRun

# Number of concurrent tuners to advertise to Plex (default: 2)
# Set higher (e.g., 4, 6, 10) if you want Plex to record/stream more channels simultaneously
HDHR_TUNER_COUNT=2

# HDHR_DISABLE_SSDP: 1 = disabled (default, works on all platforms)
#                    0 = enabled (Linux only; also uncomment 1900:1900/udp in docker-compose.yml)
HDHR_DISABLE_SSDP=1

# --- Stream proxy tuning (channel browser player) ---
# STREAM_CHUNK_KB: Size of each chunk read from the upstream source (default: 64)
#   Larger values (128, 256) reduce overhead; too large may increase latency.
# STREAM_CHUNK_KB=64

# STREAM_PREBUFFER_KB: How many KB to buffer server-side before sending to the browser (default: 512)
#   Increase (e.g. 1024, 2048) if streams stutter shortly after starting.
#   Set to 0 to disable pre-buffering.
# STREAM_PREBUFFER_KB=512

# PLAYER_STASH_KB: mpegts.js client-side stash buffer in KB (default: 1024)
#   Larger values absorb more upstream jitter at the cost of startup latency.
# PLAYER_STASH_KB=1024

# PLAYER_LATENCY_MAX: Max live buffer latency in seconds before mpegts.js skips ahead (default: 30)
# PLAYER_LATENCY_MAX=30

# PLAYER_LATENCY_MIN: Minimum buffer to keep in seconds (default: 5)
# PLAYER_LATENCY_MIN=5

# EPG (Electronic Program Guide) source
# Uses epg.pw — a free XMLTV service with AI-generated US channel guide data.
# To use a different source, set EPG_XML_SOURCES to a comma-separated list of XMLTV URLs.
# Leave unset to use the default: https://epg.pw/xmltv/epg_US.xml
# EPG_XML_SOURCES=https://epg.pw/xmltv/epg_US.xml

# How long (in hours) to cache the downloaded EPG before re-fetching (default: 12)
# EPG_CACHE_HOURS=12

# Allow downloading the full M3U playlist from your IPTV provider (default: 1)
# Set to 0 to disable the Fetch M3U button in the UI (e.g. to prevent accidental re-fetches
# or hitting provider rate limits on a shared/production deployment).
# ALLOW_FULL_M3U_DOWNLOAD=1
