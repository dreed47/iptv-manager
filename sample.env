# Copy this file to .env and edit as needed

# Port the app listens on (host port when bridge mode, uvicorn port when host mode)
# Set a unique APP_PORT per folder if you want to run multiple instances
APP_PORT=5005


# Resource limits — prevents a single container from consuming all host memory/CPU.
# MEMORY_LIMIT: Docker memory cap (default: 512m). Accepts: 256m, 512m, 1g, 2g, etc.
#   After the SQLite cache rewrite, steady-state RAM is ~80–100 MB per instance.
#   A 512 m ceiling gives plenty of headroom for cache builds and leaves room for
#   multiple instances on the same host. Lower to 256m if you are tight on RAM.
# CPU_LIMIT: Max CPU cores (default: 1.0). Use 0.5 for half a core, 2.0 for two.
# MEMORY_LIMIT=512m
# CPU_LIMIT=1.0

# Uvicorn worker request limit — worker restarts after this many requests (default: 100000)
# Acts as a memory-leak safety valve. At typical load (~80 req/min) 100k ≈ 20 hours between restarts.
# Restarts drop active streams; raise this value if you see unexpected stream cuts.
# Set very high (e.g. 1000000) to effectively disable recycling.
# UVICORN_MAX_REQUESTS=100000

# Docker restart policy (default: unless-stopped)
# Set to "no" to prevent the container from auto-restarting (e.g. for maintenance).
# Valid values: no, always, unless-stopped, on-failure
# After changing, run: docker compose up -d  (re-reads the compose file)
# RESTART_POLICY=no

# Timezone for log timestamps (default: UTC)
# Use a tz database name: America/New_York, America/Chicago, America/Los_Angeles, Europe/London, etc.
# TZ=America/New_York

# Log verbosity (default: INFO)
# INFO  — normal operation: startup, stream start/end, M3U fetches, VPN/MQTT connect
# DEBUG — everything: per-request timing, channel loading, EPG matching, stream reconnect details
# WARNING — only problems and errors
# LOG_LEVEL=INFO

# Docker container name (default: iptv-app)
# Change this when running multiple instances to avoid name conflicts.
CONTAINER_NAME=iptv-app

# Advertised host that Plex will use to reach the app
# If Plex is on the SAME Mac, set to 127.0.0.1 (recommended)
# If Plex is on ANOTHER machine, set to this Mac's LAN IP (e.g., 192.168.1.50)
# Note: host.docker.internal only resolves INSIDE containers; Plex (on host) won't resolve it.
HDHR_ADVERTISE_HOST=127.0.0.1
HDHR_SCHEME=http

# Model number shown in Plex (default: "HDHR3-US")
# Common HDHomeRun models: HDHR3-US, HDHR4-2US, HDHR5-4US, HDTC-2US
HDHR_MODEL=HDHR3-US

# Friendly name shown in Plex for this HDHomeRun device (default: "IPTV HDHomeRun")
# Useful for distinguishing multiple instances (e.g., "IPTV Sports", "IPTV News")
HDHR_FRIENDLY_NAME=IPTV HDHomeRun

# Number of concurrent tuners to advertise to Plex (default: 2)
# Set higher (e.g., 4, 6, 10) if you want Plex to record/stream more channels simultaneously
HDHR_TUNER_COUNT=2

# HDHR_DISABLE_SSDP: 1 = disabled (default, works on all platforms)
#                    0 = enabled (Linux only; also uncomment 1900:1900/udp in docker-compose.yml)
HDHR_DISABLE_SSDP=0

# --- Stream proxy tuning (channel browser player) ---
# STREAM_CHUNK_KB: Chunk size for the in-browser player path (default: 256 KB).
#   Larger values (128–1024) reduce overhead for the browser player.  Does NOT affect
#   the hub producer — use HUB_CHUNK_KB for that.
# STREAM_CHUNK_KB=256

# HUB_CHUNK_KB: Chunk size for the per-channel hub producer (default: falls back to STREAM_CHUNK_KB).
#   Keep this small (64–256) for live streams — large values (1024) add ~1s of live latency
#   per chunk and make ring-buffer seeding lag more visible to the player.
# HUB_CHUNK_KB=256

# STREAM_PREBUFFER_KB: How many KB to buffer server-side before sending to the browser (default: 512)
#   Increase (e.g. 1024, 2048) if streams stutter shortly after starting.
#   Set to 0 to disable pre-buffering.
# STREAM_PREBUFFER_KB=512

# PLAYER_STASH_KB: mpegts.js client-side stash buffer in KB (default: 1024)
#   Larger values absorb more upstream jitter at the cost of startup latency.
# PLAYER_STASH_KB=1024

# PLAYER_LATENCY_MAX: Max live buffer latency in seconds before mpegts.js skips ahead (default: 30)
# PLAYER_LATENCY_MAX=30

# PLAYER_LATENCY_MIN: Minimum buffer to keep in seconds (default: 5)
# PLAYER_LATENCY_MIN=5

# HEALTH_CHECK_TVG_ID: Channel TVG-ID used by GET /api/health for automated monitoring (Uptime Kuma, Home Assistant).
# Pick a reliable channel you rarely watch so probes don't clash with live viewing.
# Find the ID on the stream_test page or in your provider's channel list.
# HEALTH_CHECK_TVG_ID=325020

# STREAM_MAX_RETRIES: How many times to reconnect to the upstream source if the stream drops (default: 10)
#   Increase for more resilient streams on unstable providers; set to 0 to disable reconnects.
# STREAM_MAX_RETRIES=10

# STREAM_RETRY_DELAY: Seconds to wait between reconnect attempts (default: 3)
# STREAM_RETRY_DELAY=3

# STREAM_READ_TIMEOUT: Seconds without data before the proxy treats the stream as stale and reconnects (default: 60)
#   Lower values (e.g. 15) catch silent hangs faster; higher values tolerate more upstream jitter.
# STREAM_READ_TIMEOUT=60

# STREAM_SESSION_STALE_SECONDS: Seconds after the last received chunk before a session is considered dead (default: 30)
#   Used by the health check to avoid false "stream active" reports after a client disconnects.
# STREAM_SESSION_STALE_SECONDS=30

# --- Bandwidth cap mitigation ---
# If your IPTV provider caps upstream delivery (e.g. ~15 Mbps), these settings help reduce buffering
# on high-quality channels.

# XTREAM_PREBUFFER_KB: Server-side prebuffer for Xtream/TiviMate live streams (default: 0 = disabled)
#   Raise to 2048 to give clients a reservoir that absorbs momentary delivery dips.
# XTREAM_PREBUFFER_KB=2048

# HUB_RING_CHUNKS: Ring buffer depth for the per-channel upstream hub (default: 250, ~16 MB at 64 KB chunks)
#   Raise to 200 (~12.8 MB) when streams frequently buffer due to bursty delivery.
# HUB_RING_CHUNKS=200

# HUB_CONSUMER_Q: Per-client queue depth (default: 180, ~8 MB at 64 KB chunks)
#   Raise alongside HUB_RING_CHUNKS (e.g. 200) so fast producers don't overflow slow consumers.
# HUB_CONSUMER_Q=200

# HUB_SEED_CHUNKS: How many ring buffer chunks to pre-seed into a new consumer's queue (default: 8, ~512 KB).
#   Keeping this small prevents live streams from jumping back on connect/reconnect.
#   Apple TV probes still get immediate data; only the catch-up depth changes.
# HUB_SEED_CHUNKS=8

# HLS_MAX_BANDWIDTH_KBPS: Auto-select a lower-bitrate HLS variant when the provider serves a
#   multi-bitrate HLS master playlist.  Set to the max delivery bandwidth in kbps (e.g. 8000 for 8 Mbps).
#   0 = disabled (default).  Has no effect on MPEG-TS streams — only applies when the upstream URL
#   is an HLS master playlist (.m3u8 with multiple #EXT-X-STREAM-INF entries).
# HLS_MAX_BANDWIDTH_KBPS=8000

# EPG (Electronic Program Guide) source
# Uses epg.pw — a free XMLTV service with AI-generated US channel guide data.
# To use a different source, set EPG_XML_SOURCES to a comma-separated list of XMLTV URLs.
# Leave unset to use the default: https://epg.pw/xmltv/epg_US.xml
# EPG_XML_SOURCES=https://epg.pw/xmltv/epg_US.xml

# How long (in hours) to cache the downloaded EPG before re-fetching (default: 12)
# EPG_CACHE_HOURS=12

# Allow downloading the full M3U playlist from your IPTV provider (default: 1)
# Set to 0 to disable the Fetch M3U button in the UI (e.g. to prevent accidental re-fetches
# or hitting provider rate limits on a shared/production deployment).
# ALLOW_FULL_M3U_DOWNLOAD=1

# --- Generic IPTV Player (Xtream Codes / M3U server) ---
# Credentials that IPTV apps (TiviMate, IPTV Smarters, VLC, etc.) use to connect TO this manager.
# These are NOT your upstream provider credentials — those are stored per-config in the UI.
# Connect with: server=http://<this-host>:<APP_PORT>  username=iptv  password=iptv
# IPTV_USERNAME=iptv
# IPTV_PASSWORD=iptv
